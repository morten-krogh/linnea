{
  "log": "test/linnea.log",
  "timeout": 2,
  "max_connections": 64,
  "max_body": 1000000,
  "workers": 2,
  "servers": [
    {
      "host": "127.0.0.1",
      "port": 61080,
      "hostname": "one.test",
      "locations": [
        {
          "prefix": "/ws",
          "proxy": "127.0.0.1:61702"
        },
        {
          "prefix": "/",
          "root": "test/www",
          "cache_control": "max-age=60",
          "response_headers": [
            { "name": "X-Linnea-Static", "value": "policy" },
            { "name": "Referrer-Policy", "value": "no-referrer" }
          ]
        },
        {
          "prefix": "/api",
          "proxy": "127.0.0.1:61100"
        },
        {
          "prefix": "/down",
          "proxy": "127.0.0.1:61199"
        }
      ]
    },
    {
      "host": "127.0.0.1",
      "port": 61090,
      "hostname": "two.test",
      "locations": [
        {
          "prefix": "/",
          "root": "test/www/sub"
        },
        {
          "prefix": "/sub",
          "root": "test/www"
        },
        {
          "prefix": "/old",
          "redirect": "https://example.com"
        }
      ]
    },
    {
      "host": "127.0.0.1",
      "port": 61080,
      "hostname": "three.test",
      "locations": [
        {
          "prefix": "/",
          "root": "test/www/sub"
        }
      ]
    },
    {
      "host": "127.0.0.1",
      "port": 61080,
      "hostname": "qroot.test",
      "locations": [
        {
          "prefix": "/",
          "proxy": "127.0.0.1:61100"
        }
      ]
    }
  ]
}
