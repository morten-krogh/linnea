{
  "log": "test/linnea.log",
  "timeout": 5,
  "servers": [
    {
      "host": "127.0.0.1", "port": 47443, "hostname": "localhost",
      "cert": "test/tls/server.crt", "key": "test/tls/server.key",
      "hsts": "max-age=31536000", "nosniff": 1,
      "locations": [
        { "prefix": "/", "root": "test/www" },
        { "prefix": "/api", "proxy": "127.0.0.1:47100" },
        { "prefix": "/down", "proxy": "127.0.0.1:47199" },
        { "prefix": "/old", "redirect": "https://example.com" }
      ]
    }
  ]
}
