{
  "log": "test/linnea.log",
  "timeout": 5,
  "http2": 1,
  "servers": [
    {
      "host": "127.0.0.1", "port": 61446, "hostname": "localhost",
      "cert": "test/tls/server.crt", "key": "test/tls/server.key",
      "locations": [
        { "prefix": "/", "root": "test/www", "cache_control": "max-age=60",
          "response_headers": [
            { "name": "X-Linnea-Static", "value": "policy" },
            { "name": "Referrer-Policy", "value": "no-referrer" }
          ] }
      ]
    }
  ]
}
