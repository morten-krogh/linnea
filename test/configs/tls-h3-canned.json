{
  "log": "test/linnea-h3canned.log",
  "timeout": 2,
  "workers": 1,
  "max_body": 4096,
  "servers": [
    {
      "host": "127.0.0.1",
      "port": 61464,
      "hostname": "localhost",
      "cert": "test/tls/server.crt",
      "key": "test/tls/server.key",
      "locations": [
        { "prefix": "/api", "proxy": "127.0.0.1:61100" },
        { "prefix": "/old", "redirect": "https://example.com" },
        { "prefix": "/", "root": "test/www",
          "cache_control": "public, max-age=600",
          "response_headers": [
            { "name": "X-Linnea-Static", "value": "policy" }
          ] }
      ]
    }
  ]
}
