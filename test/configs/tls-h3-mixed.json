{
  "log": "test/linnea.log",
  "timeout": 5,
  "workers": 2,
  "servers": [
    {
      "host": "127.0.0.1",
      "port": 47461,
      "hostname": "localhost",
      "cert": "test/tls/server.crt",
      "key": "test/tls/server.key",
      "locations": [
        {
          "prefix": "/sub",
          "root": "test/www"
        },
        {
          "prefix": "/api",
          "proxy": "127.0.0.1:47100"
        },
        {
          "prefix": "/",
          "root": "test/www/sub"
        }
      ]
    },
    {
      "host": "127.0.0.1",
      "port": 47461,
      "hostname": "other.localhost",
      "cert": "test/tls/server.crt",
      "key": "test/tls/server.key",
      "locations": [
        {
          "prefix": "/",
          "root": "test/tls"
        }
      ]
    }
  ]
}