# logrotate snippet for linnea's access log.
#
# Install (one time):
#   sudo install -m 0644 config/linnea.logrotate /etc/logrotate.d/linnea
#
# The master and every worker hold their own descriptor for this file, so a
# rotation has to tell them to reopen it — otherwise they keep writing into
# the renamed inode and the new file stays empty while the disk is never
# reclaimed. SIGHUP to the master does it: it reopens its own log and passes
# the signal to each worker. `systemctl reload` would also work (it re-execs
# the master), but that is a heavier hammer than a rotation needs.
#
# `su linnea linnea` lets logrotate create the new file as the server's own
# user, so the reopen after the rotation can write to it.

/home/linnea/linnea/linnea.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0644 linnea linnea
    su linnea linnea
    postrotate
        /bin/kill -HUP $(systemctl show --property MainPID --value linnea) 2>/dev/null || true
    endscript
}
