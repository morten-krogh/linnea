# Linnea systemd unit. One-time install:
#   make && sudo make install
#   sudo cp config/linnea.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now linnea
# Routine deploy after a rebuild — zero downtime, no dropped connections:
#   make && sudo make install && sudo systemctl reload linnea
# reload sends SIGUSR2: the master re-execs the new binary in place (same
# PID), the new generation adopts the still-open listeners and starts
# serving, then the old workers drain. If the new binary rejects the
# config the reload is refused and the old generation keeps serving. A
# reload cannot change the listener set (host/port); for that use restart.
#
# kTLS needs the kernel tls module; make it persistent across boots with:
#   echo tls | sudo tee /etc/modules-load.d/ktls.conf
#
# systemd supervises the master; the master supervises the workers.
#
# Stopping the unit SIGTERMs the whole control group, and a worker exits
# straight away, dropping whatever it holds. Nothing open outlives a stop
# in any case, so there is nothing to be gained by finishing first, and
# waiting was expensive: a browser almost always holds an idle keep-alive,
# and a WebSocket tunnel never goes idle at all, so a stop used to run to
# the TimeoutStopSec kill below whenever a page was open. Clients reconnect
# to the server that comes back.
#
# SIGQUIT is the drain, and the reload path: stop accepting, finish what is
# open, exit when the last one closes or after the drain deadline in
# linnea_uring, whichever comes first. That is what the master sends its old
# workers during a hot upgrade, where the new generation is already serving
# and finishing those last requests is the whole point.
#
# SIGHUP reopens the log, for logrotate (see config/linnea.logrotate).
#
# The workers' PR_SET_PDEATHSIG covers a master that dies on its own.

[Unit]
Description=Linnea HTTP/TLS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linnea
Group=linnea
# the config's root and log paths are relative to this directory
WorkingDirectory=/home/linnea/linnea
ExecStart=/usr/local/bin/linnea --config /home/linnea/linnea/config/linnea-tls.json
# An ExecStartPre=/usr/local/bin/linnea --test --config <path> would refuse to
# start on a bad config rather than failing in ExecStart; left off by default.
# reload = zero-downtime binary upgrade (SIGUSR2, re-exec in place). The
# PID is preserved across the exec, so MainPID tracking survives.
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=1
# A stop exits at once, so this should never be reached. It stays as the
# backstop for a worker wedged somewhere it cannot answer a signal from,
# and because the 45s default is far too long to wait to find that out.
TimeoutStopSec=10
# There is deliberately no LimitNOFILE here, and adding one would make things
# worse rather than better.
#
# Every connection is a descriptor and a TLS proxy connection is two, so the
# default soft limit of 1024 sits below the configured max_connections: the
# limit is reached before the pool fills, and accept(2) starts failing with
# EMFILE while the server still believes it has room. The server fixes that
# itself — before forking, the master computes what one worker can hold
# (max_connections + max_upstream + the listeners + slack) and raises its own
# soft limit to it, which every worker inherits. A process may do that up to
# the hard limit without privilege. That number tracks the config; a constant
# written here would not, and would drift the moment max_connections changed.
#
# The trap: a bare "LimitNOFILE=N" sets the hard limit as well as the soft one.
# systemd's default hard limit is 524288, so LimitNOFILE=65536 would LOWER the
# ceiling the server is allowed to raise itself to, by a factor of eight —
# taking away the headroom it was meant to provide. If a limit ever does need
# stating here, spell it soft:hard (e.g. 1024:524288) so the ceiling survives.

# Grant capabilities as ambient (not file caps on the binary), so a rebuilt
# bin/linnea keeps working with no setcap re-run:
#   CAP_NET_BIND_SERVICE  bind 80/443 without root
#   CAP_BPF, CAP_NET_ADMIN  load the SK_REUSEPORT connection-ID steering program
#     (src/linnea_bpf.asm) so HTTP/3 survives client migration. Without them the
#     load fails and the QUIC reuseport group falls back to plain 4-tuple hashing.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
NoNewPrivileges=true

# Hardening: read-only /usr /boot /etc, private /tmp, no kernel tunables.
# /home stays visible: the binary, config, docroot, log and certs live there.
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
