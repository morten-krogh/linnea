# The WebSocket backend behind linnea2.amberbio.com's /ws location: the shared
# counter the site's index page increments, and broadcasts to every open tab.
#
# One-time install:
#   make && sudo make install
#   sudo cp config/linnea-ws.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now linnea-ws
# After a rebuild:
#   make && sudo make install && sudo systemctl restart linnea-ws
#
# It listens on 127.0.0.1 only and is reached exclusively through linnea, which
# relays an accepted upgrade to it as an opaque tunnel. Nothing outside the box
# can talk to it directly, and it needs no capabilities: 7701 is unprivileged.
#
# A restart resets the counter to zero and drops every open socket — the count
# lives in memory and nowhere else. The page reconnects on its own, so the only
# visible effect is the number starting again.

[Unit]
Description=Linnea websocket backend (shared counter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linnea
Group=linnea
WorkingDirectory=/
ExecStart=/usr/local/bin/linnea-ws 7701
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

# It binds a loopback port and touches nothing else — no files at all, unlike
# the /api backend, which at least needs a temporary directory. Hence no
# working directory worth having, and ProtectHome on top.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
