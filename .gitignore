# Object files
*.o
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/

\#*\#
.\#*
# Server log files
*.log
*.log.rot

# Fixtures the suite writes into its document root. Only a handful of files
# under test/www are real (hello.txt, index.html, style.css, favicon.ico,
# "a b.txt", sub/) — the rest are made and usually removed by run_tests.sh.
# Some live only for the length of one check, so whether they are on disk
# depends on where the suite has got to, and `git add -A` DURING a run will
# otherwise sweep them into a commit.
test/www/big.txt
test/www/big2.txt
test/www/med.txt
test/www/huge.bin
test/www/up.bin
test/www/h3big.bin
test/www/h2drain.bin
test/www/h3range.bin
test/www/h2range.bin
test/www/upload.bin
test/www/upload2.bin
test/www/enc.txt
test/www/enc.txt.gz
test/www/enc.txt.br
test/www/h3big2.bin
test/www/h3big3.bin
test/www/h3big4.bin
test/www/linnea.png
test/www/h3s*.bin
test/www/h3p*.bin
test/www/m*.bin
# The mime battery writes test/www/probe.<ext> for one extension after another,
# so this is a pattern rather than a list of the types it happens to try today.
test/www/probe.*
test/www/clip.mp4
test/www/varonly.txt.br
test/www/drain.bin
test/www/up1.bin
test/www/up2.bin
test/www/h2upload.bin
test/www/tlsupload.bin
linnea-qdbg

# Python bytecode. The suite's helpers are run as scripts, so this only appears
# when one is imported as a module — which a verification script did once, and
# the .pyc rode into a commit behind `git add -A`.
__pycache__/
*.pyc
test/run-*/
test/shards/out/
